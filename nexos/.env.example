# UUIDs de Authentication > Users, separados por vírgulas. Vazio bloqueia admin.
DASHBOARD_ADMIN_USER_IDS=

# Cloudflare Turnstile: obrigatório em produção. Crie o widget para seu domínio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCED=true  # também exige em desenvolvimento

# Asaas — credenciais do ambiente correspondente; token igual ao do webhook.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Segredo aleatório independente (mínimo de 32 caracteres).
CHECKOUT_STATUS_SECRET=

# Notion — formulário de contato: integração conectada ao database.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Diagnóstico Cloudflare (opcional).
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
