# Site: origem exata, sem curingas. SITE_URL é a configuração do backend.
# IMPORTANTE: em produção, defina os DOIS com o domínio real (https://seudominio.com).
# SITE_URL/NEXT_PUBLIC_SITE_URL ausentes em produção causam "Origem inválida".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Supabase — Postgres/Data API. A chave pública pode ir ao navegador;
# o segredo fica SOMENTE no servidor.
SUPABASE_URL=https://lgfttyeezviecfqbbmqk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_W-Cd2nc-l0PpLJPepTYwGA_WO0OKD3L
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://lgfttyeezviecfqbbmqk.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://lgfttyeezviecfqbbmqk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_W-Cd2nc-l0PpLJPepTYwGA_WO0OKD3L

# ── Better Auth ────────────────────────────────────────────────────────
# Fonte de identidade e sessão do app. A migração de usuários está em
# supabase/migrations/20260930120100_cutover_to_better_auth.sql.
#
# BETTER_AUTH_SECRET: gere com `openssl rand -base64 32`. Mínimo de 32
# caracteres. Trocar este valor invalida todas as sessões e cookies assinados.
BETTER_AUTH_SECRET=
# Conexão direta ao Postgres do projeto (não a URL da API).
# Onde encontrar: Supabase > Project Settings > Database > Connection string > URI.
# Sem esta variável a aplicação não sobe: o Better Auth não cai para Data API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# OAuth — Google. Callback: {SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth — GitHub. Callback: {SITE_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Reutiliza os providers já configurados no Supabase (callback externo /auth/v1/callback).
# A sessão final continua Better Auth. Autorize {SITE_URL}/api/auth/supabase/callback
# em Supabase > Authentication > URL Configuration > Redirect URLs.
SOCIAL_AUTH_USE_SUPABASE=false
# Passkeys: RP ID e origem são derivados de SITE_URL. Não compartilhar credenciais
# entre localhost e produção; em produção use sempre o domínio canônico HTTPS.
# DATABASE_POOL_MAX=2
# DATABASE_SSL=false  # somente Postgres local de testes sem TLS

# Admin — o papel vem do plugin admin (coluna `role` em public."user"),
# não de allowlist. Conceda com:
#   update public."user" set role = 'admin' where email = 'voce@exemplo.com';
# A variável abaixo é legada, do modelo Supabase Auth, e não é mais lida.
DASHBOARD_ADMIN_USER_IDS=

# Cloudflare Turnstile: obrigatório em produção. Crie o widget para seu domínio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCED=true  # também exige em desenvolvimento

# Checkout — segredo para tokens de status (mínimo 32 caracteres).
CHECKOUT_STATUS_SECRET=

# Asaas — token de webhook para validação de origem.
ASAAS_WEBHOOK_TOKEN=

# Asaas — credenciais do ambiente correspondente; token igual ao do webhook.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# URL pública do webhook (obrigatório para webhook do Asaas funcionar)
ASAAS_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/checkout
# Segredo aleatório independente (mínimo de 32 caracteres).
CHECKOUT_STATUS_SECRET=

# Notion — formulário de contato: integração conectada ao database.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Diagnóstico Cloudflare (opcional).
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Resend — Email delivery
# Crie API key em https://resend.com/api-keys
# Verifique domínio em https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=NexOS <noreply@seudominio.com>
# Retentativas da outbox: configure este segredo para /api/internal/email-outbox.
# No Vercel, o mesmo nome é usado para autenticar Cron Jobs.
CRON_SECRET=
# React Bits Pro CLI registry authentication (server/private; never NEXT_PUBLIC).
# Add your license to .env.local before installing Pro components.
REACTBITS_LICENSE_KEY=
