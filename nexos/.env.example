# Site: origem exata, sem curingas. SITE_URL é a configuração do backend.
# IMPORTANTE: em produção, defina os DOIS com o domínio real (https://seudominio.com).
# SITE_URL/NEXT_PUBLIC_SITE_URL ausentes em produção causam "Origem inválida".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Supabase — chave pública pode ir ao navegador. Segredo somente no servidor.
SUPABASE_URL=https://lgfttyeezviecfqbbmqk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_W-Cd2nc-l0PpLJPepTYwGA_WO0OKD3L
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://lgfttyeezviecfqbbmqk.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://lgfttyeezviecfqbbmqk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_W-Cd2nc-l0PpLJPepTYwGA_WO0OKD3L

# Cloudflare Turnstile: obrigatório em produção. Crie o widget para seu domínio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCED=true  # também exige em desenvolvimento

# Checkout — segredo para tokens de status (mínimo 32 caracteres).
CHECKOUT_STATUS_SECRET=

# Asaas — token de webhook para validação de origem.
ASAAS_WEBHOOK_TOKEN=

# Allowlist de admins (Authentication > Users), separados por vírgulas. Vazio bloqueia admin.
# Rota do admin em produção: /admin-dashboard-su/secure-entry
DASHBOARD_ADMIN_USER_IDS=

# Asaas — credenciais do ambiente correspondente; token igual ao do webhook.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# URL pública do webhook (obrigatório para webhook do Asaas funcionar)
ASAAS_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/checkout
# Segredo aleatório independente (mínimo de 32 caracteres).
CHECKOUT_STATUS_SECRET=

# Notion — formulário de contato: integração conectada ao database.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Diagnóstico Cloudflare (opcional).
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
